{
  "name": "dsh-session-tariff",
  "version": "1.3.1",
  "description": "在输入框状态栏显示本会话估算花费，按高峰/空闲时段分档计价；价目可在设置→插件里按 DSH 实际模型与供应商编辑并即时生效 · DSH plugin: estimated session cost in the composer status bar, with an in-GUI price-book editor that follows the live provider/model catalog",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cost",
    "usage",
    "pricing",
    "tariff"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "host.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "test/*.mjs",
    "README.en.md",
    "README.ja.md",
    "README.zh-TW.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xuanyuanli/dsh-session-tariff.git"
  },
  "homepage": "https://github.com/xuanyuanli/dsh-session-tariff#readme",
  "bugs": {
    "url": "https://github.com/xuanyuanli/dsh-session-tariff/issues"
  },
  "scripts": {
    "test": "node --test test/fold.test.mjs test/editor.test.mjs test/client.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  }
}
